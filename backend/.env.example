# =============================================================================
# ClientSphere Backend – Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- MongoDB -----------------------------------------------------------------
MONGODB_URI=mongodb+srv://mohdyalnaaz_db_user:YALnaaz786*@clientsphere.3zfme6a.mongodb.net/?appName=clientsphere

# --- JWT Authentication (ARCHITECTURE_DECISIONS.md §4) -----------------------
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# --- Cloudinary (ARCHITECTURE_DECISIONS.md §2) -------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Google Gemini API -------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# --- Redis (BullMQ broker) ---------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Email (Nodemailer / SMTP) -----------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=ClientSphere
EMAIL_FROM_ADDRESS=no-reply@clientsphere.io

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins. No trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (used for password reset and invitation links) -----------------
FRONTEND_URL=http://localhost:5173

# --- Rate Limiting -----------------------------------------------------------
# Window duration in minutes and maximum requests per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
